# Copy this to .env and fill in your own values.
#
# 1. Create a Notion internal integration at https://www.notion.so/my-integrations
# 2. Create (or duplicate) your own Experience Bank and Applications databases in Notion.
# 3. Share BOTH databases with the integration individually via each database's
#    "..." menu -> Connections. A database does NOT inherit access from a
#    connected parent page automatically -- this trips people up every time.
# 4. Get each database's data source ID: open it in Notion, copy the URL, the
#    32-character ID right after the workspace name (before any "?") is it.

NOTION_TOKEN=
NOTION_EXPERIENCE_BANK_DATA_SOURCE_ID=
NOTION_APPLICATIONS_DATA_SOURCE_ID=
